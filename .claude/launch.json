{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@specfix/web"],
      "port": 3000
    },
    {
      "name": "web-system-ca",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@specfix/web"],
      "env": { "NODE_OPTIONS": "--use-system-ca" },
      "port": 3000
    }
  ]
}
