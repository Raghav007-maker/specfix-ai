# SpecFix environment variables. Copy to .env and fill in. Names and comments only:
# never put a real value in this file. On Azure, the same names go in App Service →
# Settings → Environment variables.

# --- Azure OpenAI --------------------------------------------------------------
# Azure Portal → your OpenAI resource → Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
# Deployment names, exactly as created in Azure.
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_JUDGE=
OPENAI_MODEL_COMPILE=
OPENAI_MODEL_EMBED=
# Optional; defaults to OPENAI_MODEL_JUDGE.
OPENAI_MODEL_AGENT=
# Determinism, so a metric change can be traced to a prompt change (e.g. 0 and a fixed seed).
OPENAI_TEMPERATURE=
OPENAI_SEED=
# Hard ceiling on ticket text per analysis; longer input is truncated.
MAX_TICKET_INPUT_TOKENS=

# --- Supabase / Postgres -------------------------------------------------------
# Project Settings → API (URL, anon key, service_role key) and → Database (connection string).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The team's real database. Never run tests against it; tests use SPECFIX_TEST_DATABASE_URL.
DATABASE_URL=
# Disposable test database (docker compose up -d --wait testdb), e.g.
# postgres://postgres:postgres@127.0.0.1:54329/specfix_test
SPECFIX_TEST_DATABASE_URL=

# --- Queue ---------------------------------------------------------------------
REDIS_URL=

# --- App -----------------------------------------------------------------------
# This app's own address (OAuth return URLs, links in emails), e.g. http://localhost:3000.
PUBLIC_BASE_URL=
# 32-byte key used to encrypt stored tokens (packages/db/src/crypto.ts).
TOKEN_ENCRYPTION_KEY=
# Comma-separated emails of the SpecFix team: no plan limits.
SPECFIX_OWNER_EMAILS=

# --- Sign-in -------------------------------------------------------------------
# 1 shows "Continue with Google"; set it only after the Google provider is set up in Supabase.
GOOGLE_SIGN_IN_ENABLED=
# Cloudflare Turnstile site key (public). Unset = no human check. Its secret goes in Supabase
# (Authentication → Attack Protection → CAPTCHA), never here.
TURNSTILE_SITE_KEY=

# --- Jira (OAuth 2.0 3LO) ------------------------------------------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
JIRA_WEBHOOK_SECRET=

# --- GitHub App (docs/github-app.md) -------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Conversational resolution agent (optional) ---------------------------------
# on = show the Conversation tab.
SPECFIX_RESOLUTION_AGENT=
AGENT_TIMEOUT_MS=
AGENT_MAX_RETRIES=
AGENT_COST_CEILING_USD=

# --- Payments ------------------------------------------------------------------
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
