{
  "name": "specfix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ambiguity and gap detection for product requirements (Phase 1)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:reset": "tsx packages/db/scripts/migrate.ts --reset",
    "eval": "tsx packages/eval/src/cli.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.14.0",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  }
}
